# Carteira-RESERVA (NÃO as gatilhos). Preencha e salve como topup.env (chmod 600).
# Uma chave EVM serve para BNB (BSC) E ETH (Ethereum) — mesmo endereço nas duas.
RESERVE_EVM_KEY=0xSUA_CHAVE_HEX_DA_RESERVA_EVM
# Reserva SOL: default é o BirXd4Q (já tem saldo); troque se quiser outra:
# SOLANA_KEYPAIR=/home/lunc/keys/solana-keypair-BirXd4Q...json
COOLDOWN_H=6
