# rpc.env — endpoints RPC/LCD compartilhados pelos serviços (claim-agent, epoch-reporter)
# e pelos scripts de deploy/operação. Fonte única: mude AQUI, não no código.
# Na VPS: /root/claim-agent/rpc.env, carregado via EnvironmentFile= nos dois units.

# Terra Classic (columbus-5)
TC_RPC=https://rpc.terra-classic.hexxagon.io
TC_LCD=https://lcd.terra-classic.hexxagon.io

# BSC
BSC_RPC=https://bsc-dataseed.bnbchain.org

# Ethereum
ETH_RPC=https://ethereum-rpc.publicnode.com

# Solana
SOLANA_RPC=https://api.mainnet-beta.solana.com
