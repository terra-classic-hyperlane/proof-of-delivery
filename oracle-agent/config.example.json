{
  "$comment": "Copie para config.json. Cada entrada em `chains` é UMA chain local onde o agente atualiza o oracle (via governor); `remotes` são os domínios remotos cujo preço é cotado NA MOEDA local. ATENÇÃO: cada deployment tem convenção própria — TC usa rate=LUNC/NATIVO×1e12 (inversa!), EVM/SOL remotos têm calibração por alvo (WARP-GAS-CONFIG.md). As FAIXAS nos governors protegem contra submissão em convenção errada; TODO: formulas por chain no agente.",

  "intervalSeconds": 3600,
  "coingecko": {
    "baseUrl": "https://api.coingecko.com/api/v3",
    "ids": {
      "terraclassic": "terra-luna",
      "bsc": "binancecoin",
      "ethereum": "ethereum",
      "solana": "solana"
    }
  },

  "chains": {
    "terraclassic": {
      "type": "cosmwasm",
      "enabled": true,
      "localCoin": "terraclassic",
      "rpc": "https://terra-classic-rpc.publicnode.com",
      "chainId": "columbus-5",
      "gasPrice": "28.325uluna",
      "prefix": "terra",
      "governor": "terra1...ENDERECO_DO_ORACLE_GOVERNOR",
      "mnemonicEnv": "TC_MNEMONIC",
      "remotes": {
        "56":         { "coin": "bsc",      "gasPriceSource": { "type": "evm-rpc", "url": "https://bsc-rpc.publicnode.com" } },
        "1":          { "coin": "ethereum", "gasPriceSource": { "type": "evm-rpc", "url": "https://ethereum-rpc.publicnode.com" } },
        "1399811149": { "coin": "solana",   "gasPriceSource": { "type": "fixed", "value": "1" } }
      }
    },
    "bsc": {
      "type": "evm",
      "enabled": true,
      "localCoin": "bsc",
      "rpc": "https://bsc-rpc.publicnode.com",
      "governor": "0x...ENDERECO_DO_GASORACLEGOVERNOR",
      "privateKeyEnv": "EVM_PRIVATE_KEY",
